# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ONS HEALTHCARE OWNER IDENTITY:
# Replace with the authorized Google Account email of the owner.
# Only this explicitly configured email address can receive owner privileges.
VITE_OWNER_EMAIL="replace-with-the-owner-email"

# FIREBASE CONFIGURATION (Web Client SDK):
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="ons-healthcare.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ons-healthcare"
VITE_FIREBASE_STORAGE_BUCKET="ons-healthcare.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"

# WHATSAPP BUSINESS PLATFORM (Meta Cloud API - Server-side only):
# Configured securely in server environment (never exposed in client bundles).
# Phone Number ID from Meta Business Developer dashboard
WHATSAPP_PHONE_NUMBER_ID=""
# System User / Permanent Access Token with whatsapp_business_messaging permission
WHATSAPP_API_TOKEN=""
# Meta WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Cloud API version (default v21.0)
WHATSAPP_API_VERSION="v21.0"
# Server-side fallback recipient numbers (can also be configured dynamically in Admin UI)
WHATSAPP_RECIPIENT_A=""
WHATSAPP_RECIPIENT_B=""
# Pre-approved template name if using template messages outside 24h customer window
WHATSAPP_TEMPLATE_NAME="ons_new_order_alert"
